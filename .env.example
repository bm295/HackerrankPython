LLM_PROVIDER=mock
LLM_MODEL=gpt-4.1-mini
RESEARCH_PROVIDER=web
MAX_FILES_ANALYZED=120
MAX_FILE_SIZE=200000
IGNORED_DIRS=node_modules,dist,build,coverage,.git,vendor,.angular
IGNORED_PATTERNS=*.min.js,*.map
RESEARCH_SOURCE_COUNT=3
RANDOM_SEED=
LOG_LEVEL=info
# Topic selection: catalog, discover, or hybrid
TOPIC_MODE=hybrid
SEARCH_ENDPOINT=https://html.duckduckgo.com/html/
SEARCH_RESULT_COUNT=8
SEARCH_TIMEOUT=10
